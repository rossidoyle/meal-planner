<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MealPlanner.Models"
             xmlns:viewModels="clr-namespace:MealPlanner.ViewModels"
             x:Class="MealPlanner.Views.RecipeListPage"
             x:DataType="viewModels:RecipeListViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <SearchBar Grid.Row="0"
                   Placeholder="Search recipes"
                   Text="{Binding SearchText}"
                   SearchCommand="{Binding LoadRecipesCommand}" />

        <HorizontalStackLayout Grid.Row="1"
                              Spacing="12"
                              Margin="16,0,16,4">
            <Switch IsToggled="{Binding SharedOnly}"
                    SemanticProperties.Description="Show only recipes shared with the community" />
            <Label Text="Only shared"
                   VerticalOptions="Center"
                   FontSize="14" />
        </HorizontalStackLayout>

        <Grid Grid.Row="2">

            <CollectionView ItemsSource="{Binding Recipes}"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                                       ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Recipe">
                        <Border Margin="16,8,16,0"
                                Padding="16"
                                StrokeShape="RoundRectangle 12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:RecipeListViewModel}}, Path=OpenRecipeCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Name}"
                                       FontSize="18"
                                       FontAttributes="Bold" />
                                <Label FontSize="12"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                                       Text="{Binding Author, StringFormat='from {0}'}"
                                       IsVisible="{Binding Author, Converter={StaticResource NotEmpty}}" />
                                <Label Text="{Binding Description}"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation" />
                                <HorizontalStackLayout Spacing="16">
                                    <Label FontSize="12"
                                           Text="{Binding Servings, StringFormat='Serves {0}'}" />
                                    <Label FontSize="12"
                                           Text="{Binding PrepMinutes, StringFormat='Prep {0} min'}" />
                                    <Label FontSize="12"
                                           Text="{Binding CookMinutes, StringFormat='Cook {0} min'}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                 Spacing="8"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <Label Text="No recipes yet"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />
                <Label Text="Add your own, or head to the Community tab to import a few."
                       FontSize="14"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <ActivityIndicator IsVisible="{Binding IsBusy}"
                               IsRunning="{Binding IsBusy}"
                               VerticalOptions="Start"
                               HorizontalOptions="Center"
                               Margin="0,12,0,0" />
        </Grid>

        <Button Grid.Row="3"
                Margin="16"
                Text="Add recipe"
                Command="{Binding OpenRecipeCommand}" />

    </Grid>

</ContentPage>